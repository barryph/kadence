EXPO_PUBLIC_SERVER_URL=http://localhost:3000

# Google Sign-In (public values, embedded in the app bundle)
# The web/server client ID — must match the backend's GOOGLE_SERVER_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# The iOS client ID from the Google Cloud Console.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Build-time only (set in EAS/eas.json or shell before prebuild, NOT EXPO_PUBLIC):
# GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.<ios-client-id>

